<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<Version>1.7.5</Version>
		<Authors>WebVella</Authors>
		<Description>The Mail Plugin for the open-source and free platform WebVella ERP. It provides API, services and management for sending emails through SMTP services.</Description>
		<Copyright>Copyright 2019</Copyright>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageProjectUrl>https://webvella.com</PackageProjectUrl>
		<Icon>https://webvella.com/favicon.ico</Icon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/WebVella/WebVella-ERP.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!-- Security H-20 (CWE-74, CWE-93 CRLF injection, OWASP A06:2021): keep this at or above 4.16.0.
		     Earlier versions accept an injected STARTTLS response through an unflushed stream buffer,
		     which downgrades the authentication mechanism. This pin also carries the patched MimeKit
		     transitively (MailKit 4.17.0 depends on MimeKit 4.17.0), closing the companion CRLF-injection
		     advisory; do not add a direct MimeKit reference to do the same job. -->
		<PackageReference Include="MailKit" Version="4.17.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\WebVella.Erp.Web\WebVella.Erp.Web.csproj" />
		<!-- Security H-19: keep this directory segment cased exactly as the folder on disk. An
		     upper-cased "WebVella.ERP" broke solution-wide restore on case-sensitive filesystems,
		     dropping the core project and every advisory it carries out of the dependency-audit
		     graph, so the vulnerability scan read falsely clean. -->
		<ProjectReference Include="..\WebVella.Erp\WebVella.Erp.csproj" />
	</ItemGroup>
</Project>
