@using WebVella.Erp.Api.Models;
@using WebVella.Erp.Web.Models;
@{
	var erpUser = (ErpUser)ViewBag.CurrentUser;
	var siteMenu = (List<MenuItem>)ViewBag.SiteMenu;
}

<!--c:UserNav_Default-->
@if (siteMenu.Count > 0)
{
	<div class="menu-nav-wrapper">
		<div class="menu-nav dropdown">
			<a href="javascript:void(0)" class="pl-2 pr-2" data-navclick-handler>
				<span class="fa fa-bars icon"></span>
			</a>
		</div>
		<div class="dropdown-menu level-0">
			@foreach (var menuItem in siteMenu)
			{
				@* SECURITY - finding H-06 (CWE-79, OWASP A03: stored cross-site scripting). REMEDIATED.
				   THREAT: MenuItem.Content is database-sourced site-menu content, and this component
				   renders on every page of all seven host applications - it is invoked from
				   Components/Nav/Nav.Default.cshtml:L23.
				   WHERE IT IS FIXED: at the point of composition, not at this sink. The single producer
				   of SiteMenu items is Models/BaseErpPageModel.cs, which now percent-encodes
				   sitePage.Name with EncodeUrlPathSegment before it becomes the "/s/{name}" path and
				   HTML-encodes sitePage.Label with EncodeMenuText before it becomes the link text, so
				   the anchor arriving here is server-authored markup with inert data slots.
				   WHY THIS SINK ITSELF STAYS RAW: the value is that server-built anchor tag; encoding
				   it would print the anchor as literal text in the site-menu dropdown on every page of
				   every host. The else branch below stays auto-encoded by Razor for any caller that
				   sets IsHtml to false.
				   DEFENCE IN DEPTH: markup authoring is restricted to privileged roles, plus the
				   Content-Security-Policy emitted by SecurityHeadersMiddleware (commit class 8),
				   which ships report-only by default.
				   Do not move the encoding out of Models/BaseErpPageModel.cs. *@
				@if (menuItem.IsHtml)
				{
					@Html.Raw(menuItem.Content)
				}
				else
				{
					@menuItem.Content
				}
			}
		</div>
	</div>
}
