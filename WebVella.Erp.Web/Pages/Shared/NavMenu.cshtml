@using WebVella.Erp.Web.Models;
@{
    var menu = (MenuItem)Model;

}

@if (menu.RenderWrapper)
{
	<div class="menu-nav-wrapper @menu.Class">
		<div class="menu-nav @(menu.Nodes.Count > 0 ? "dropdown" : "")">
			@* SECURITY - finding H-06 (CWE-79, OWASP A03: stored cross-site scripting). REMEDIATED.
			   THREAT: MenuItem.Content is database-sourced navigation content. Four components
			   render this view - ApplicationMenu, UserMenu, ToobarMenu and SidebarMenu - and the
			   first two are invoked from Nav.Default.cshtml, so this branch renders on every page
			   of all seven host applications.
			   WHERE IT IS FIXED: at the point of composition, not at this sink. The application-menu
			   items reaching this line are built in Models/BaseErpPageModel.cs, which now encodes
			   area.Label and node.Label with EncodeMenuText, allow-lists node.Url with
			   TryEncodeMenuUrl - encoding alone would not neutralise a "javascript:" href - and
			   allow-lists node.IconClass with EncodeMenuIconClass. Services/RenderService.cs copies
			   Content through unchanged, so it carries the encoded form. Every database-sourced slot
			   inside the markup that reaches this line is therefore inert.
			   WHY THIS SINK ITSELF STAYS RAW: the value is a server-authored anchor with an icon
			   span, and NavItem.cshtml additionally rewrites the same value AS MARKUP to inject
			   data-toggle='dropdown'; encoding it would print literal anchor HTML in the navigation
			   of every host and break dropdown toggling. The else branch stays auto-encoded by Razor
			   for any caller that sets IsHtml to false.
			   DEFENCE IN DEPTH: markup authoring is restricted to privileged roles, plus the
			   Content-Security-Policy emitted by SecurityHeadersMiddleware (commit class 8), which
			   ships report-only by default.
			   Do not move the encoding out of Models/BaseErpPageModel.cs. *@
			@if (menu.IsHtml)
			{
				@Html.Raw(menu.Content)
			}
			else
			{
				@menu.Content
			}
		</div>
		@if (menu.Nodes.Count > 0)
		{
			<div class="dropdown-menu level-0  @(menu.isDropdownRight ? "dropdown-menu-right" : "")">
				@foreach (var childMenu in menu.Nodes)
				{
					<partial name="NavItem" for="@childMenu"/>
				}
			</div>
		}
	</div>
}
else
{
	@* SECURITY - finding H-06 (CWE-79, OWASP A03: stored cross-site scripting).
	   THREAT: the same MenuItem.Content, rendered here for callers that opt out of the wrapper by
	   setting RenderWrapper to false. This view renders on every page of all seven hosts.
	   PROVENANCE OF THIS BRANCH: its only live caller carries no database data at all. The
	   "Create Task" user-menu item built at Plugins.Project/Services/RenderService.cs:L17-L24
	   sets RenderWrapper = false (L22) with IsHtml = true (L19), and its Content (L20) is a fixed
	   literal - nested div/div/a markup whose innermost element is a Font Awesome icon of class
	   'fa fa-plus'. It reaches this exact branch through AddUserMenu
	   (Models/BaseErpPageModel.cs) and UserMenu.cshtml:L11, so encoding here would print that
	   whole structure as literal text in the Projects user menu for no security benefit.
	   Any database-sourced menu item that reaches this view arrives already encoded: the builder
	   in Models/BaseErpPageModel.cs encodes labels with EncodeMenuText, allow-lists URLs with
	   TryEncodeMenuUrl and allow-lists icon classes with EncodeMenuIconClass. The else branch
	   below stays auto-encoded by Razor for any caller that sets IsHtml to false.
	   DEFENCE IN DEPTH: markup authoring is restricted to privileged roles, plus the report-only
	   Content-Security-Policy emitted by SecurityHeadersMiddleware (commit class 8).
	   Do not move the encoding out of Models/BaseErpPageModel.cs. *@
	@if (menu.IsHtml)
	{
		@Html.Raw(menu.Content)
	}
	else
	{
		@menu.Content
	}
	@foreach (var childMenu in menu.Nodes)
	{
		<partial name="NavItem" for="@childMenu"/>
	}
}