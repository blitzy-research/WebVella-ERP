@using WebVella.Erp.Web.Models;
@{
    var menu = (MenuItem)Model;

}

@if (menu.RenderWrapper)
{
	<div class="menu-nav-wrapper @menu.Class">
		<div class="menu-nav @(menu.Nodes.Count > 0 ? "dropdown" : "")">
			@* SECURITY H-06 (CWE-79 stored XSS, OWASP A03) - INTENTIONAL raw markup channel. MenuItem.Content
			   is database-sourced navigation content. Four components render this view - ApplicationMenu,
			   UserMenu, ToobarMenu and SidebarMenu - and the first two are invoked from Nav.Default.cshtml, so
			   this branch renders on every page of all seven hosts. The encoding is applied UPSTREAM in
			   Models/BaseErpPageModel.cs, which encodes area.Label and node.Label with EncodeMenuText,
			   allow-lists node.Url with TryEncodeMenuUrl (encoding alone would NOT neutralise a "javascript:"
			   href) and allow-lists node.IconClass with EncodeMenuIconClass; RenderService copies Content
			   through unchanged, so it carries the encoded form and every database-sourced slot is inert.
			   Encoding it HERE would print literal anchor HTML in the navigation of every host and break
			   dropdown toggling, because the value is a server-authored anchor and NavItem.cshtml rewrites the
			   same value AS MARKUP to inject data-toggle. Do NOT move that encoding out of BaseErpPageModel.cs.
			   The else branch stays auto-encoded by Razor for any caller that sets IsHtml to false. Defence in
			   depth: markup authoring is restricted to privileged roles, plus the report-only
			   Content-Security-Policy from SecurityHeadersMiddleware. *@
			@if (menu.IsHtml)
			{
				@Html.Raw(menu.Content)
			}
			else
			{
				@menu.Content
			}
		</div>
		@if (menu.Nodes.Count > 0)
		{
			<div class="dropdown-menu level-0  @(menu.isDropdownRight ? "dropdown-menu-right" : "")">
				@foreach (var childMenu in menu.Nodes)
				{
					<partial name="NavItem" for="@childMenu"/>
				}
			</div>
		}
	</div>
}
else
{
	@* SECURITY H-06 (CWE-79 stored XSS, OWASP A03) - INTENTIONAL raw markup channel, no-wrapper
	   branch. The same MenuItem.Content, rendered for callers that set RenderWrapper false. Its only
	   live caller is the Projects plugin's "Create Task" user-menu item, whose Content is a fixed
	   server-side literal carrying no database data at all - nested div/div/a markup around a Font
	   Awesome icon - so encoding here would print that whole structure as literal text in the Projects
	   user menu for no security benefit. Any database-sourced item that reaches this view arrives
	   already encoded upstream in Models/BaseErpPageModel.cs: labels with EncodeMenuText, URLs
	   allow-listed with TryEncodeMenuUrl, icon classes allow-listed with EncodeMenuIconClass. Do NOT
	   move that encoding out of BaseErpPageModel.cs. The else branch stays auto-encoded by Razor for
	   any caller that sets IsHtml to false. *@
	@if (menu.IsHtml)
	{
		@Html.Raw(menu.Content)
	}
	else
	{
		@menu.Content
	}
	@foreach (var childMenu in menu.Nodes)
	{
		<partial name="NavItem" for="@childMenu"/>
	}
}