@using WebVella.Erp.Web.Models;
@{
    var navItem = (MenuItem)Model;

}


@if(navItem.Nodes.Count > 0){
	navItem.Content = navItem.Content.Replace("dropdown-item","dropdown-toggle").Replace("<a","<a data-toggle='dropdown' ");
	<div class="dropdown-item dropdown dropright" style="overflow:unset">
		@* SECURITY H-06 (CWE-79 stored XSS, OWASP A03) - INTENTIONAL raw markup channel; this view renders on
		   every page of all seven hosts. MenuItem.Content arrives as server-authored markup whose
		   database-sourced slots were encoded or allow-listed in Models/BaseErpPageModel.cs - do NOT move that
		   encoding out of there - and encoding HERE would print literal anchor HTML and stop every dropdown
		   toggling, because the line above rewrites the value AS MARKUP. The residual control is that markup
		   authoring is restricted to privileged roles: the Content-Security-Policy ships REPORT-ONLY, so it
		   observes violations and blocks nothing, and enforcing it is future owner-governed work. *@
		@if (navItem.IsHtml)
		{
			@Html.Raw(navItem.Content)
		}
		else
		{
			@navItem.Content
		}
		<div class="dropdown-menu level-n">
			@foreach (var childMenu in navItem.Nodes)
			{
				<partial name="NavItem" for="@childMenu"/>
			}		
		</div>
	</div>
}
else{
	@* SECURITY H-06 - INTENTIONAL raw markup channel, leaf nodes: same content, encoding and reach as the
	   branch above. Leaf anchors are built in Models/BaseErpPageModel.cs with inert data slots (a rejected
	   URL degrades to href="#" onclick="return false"), so encoding here would print that markup as
	   visible navigation text. The else branch stays auto-encoded for callers that set IsHtml false. *@
	@if (navItem.IsHtml)
	{
		@Html.Raw(navItem.Content)
	}
	else
	{
		@navItem.Content
	}
}
