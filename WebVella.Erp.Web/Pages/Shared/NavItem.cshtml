@using WebVella.Erp.Web.Models;
@{
    var navItem = (MenuItem)Model;

}


@if(navItem.Nodes.Count > 0){
	navItem.Content = navItem.Content.Replace("dropdown-item","dropdown-toggle").Replace("<a","<a data-toggle='dropdown' ");
	<div class="dropdown-item dropdown dropright" style="overflow:unset">
		@* SECURITY TRIAGE - finding H-06 (CWE-79, OWASP A03: stored cross-site scripting).
		   THREAT: MenuItem.Content is database-sourced navigation content rendered without
		   output encoding, and this view renders on every page of all seven host applications.
		   TRIAGE OUTCOME: BY-DESIGN MARKUP CHANNEL - deliberately NOT encoded.
		   EVIDENCE: MenuItem.IsHtml defaults to true (Models/MenuItem.cs:L22) and is never
		   assigned false anywhere in the repository, so this raw branch is the only branch
		   ever taken. Every producer writes server-built anchor and icon markup - see
		   Models/BaseErpPageModel.cs:L366-L369, L381, L385, L398-L400 and L448, plus
		   Services/RenderService.cs:L465 and Plugins.Project/Services/RenderService.cs:L19.
		   Line 9 above additionally rewrites this value AS MARKUP, injecting
		   data-toggle='dropdown' by string-replacing the "<a" tag, so encoding here would not
		   merely print literal anchor HTML in the navigation - it would stop every dropdown
		   in the product from toggling.
		   The IsHtml gate is the opt-in control; the else branch below is already
		   auto-encoded by Razor for any caller that sets IsHtml to false.
		   COMPENSATING CONTROL: markup authoring is restricted to privileged roles, plus the
		   Content-Security-Policy emitted by SecurityHeadersMiddleware (commit class 8),
		   which ships report-only by default.
		   RESIDUAL (out of scope, documented only): area.Label, node.Label, node.Url,
		   node.IconClass, sitePage.Name and sitePage.Label are interpolated unencoded in
		   Models/BaseErpPageModel.cs - that builder is the true sink.
		   ACCEPTED, DOCUMENTED RISK - see docs/security/risk-register.md.
		   Do not encode this branch and do not remove the Html.Raw call. *@
		@if (navItem.IsHtml)
		{
			@Html.Raw(navItem.Content)
		}
		else
		{
			@navItem.Content
		}
		<div class="dropdown-menu level-n">
			@foreach (var childMenu in navItem.Nodes)
			{
				<partial name="NavItem" for="@childMenu"/>
			}		
		</div>
	</div>
}
else{
	@* SECURITY TRIAGE - finding H-06 (CWE-79, OWASP A03: stored cross-site scripting).
	   THREAT: the same database-sourced MenuItem.Content, rendered here for leaf nodes that
	   have no children, on every page of all seven host applications.
	   TRIAGE OUTCOME: BY-DESIGN MARKUP CHANNEL - deliberately NOT encoded.
	   EVIDENCE: MenuItem.IsHtml defaults to true (Models/MenuItem.cs:L22) and is never
	   assigned false anywhere in the repository, so this raw branch is the only branch ever
	   taken. The leaf items reaching it are built at Models/BaseErpPageModel.cs:L381, L385
	   and L389, each an anchor carrying an icon span driven by node.IconClass; encoding it
	   would print that markup as visible text in the navigation of every host. The else
	   branch below is already auto-encoded by Razor for any caller that sets IsHtml to false.
	   COMPENSATING CONTROL: markup authoring is restricted to privileged roles, plus the
	   report-only Content-Security-Policy emitted by SecurityHeadersMiddleware (class 8).
	   RESIDUAL (out of scope, documented only): node.Label, node.Url and node.IconClass are
	   interpolated unencoded in Models/BaseErpPageModel.cs - that builder is the true sink.
	   ACCEPTED, DOCUMENTED RISK - see docs/security/risk-register.md.
	   Do not encode this branch and do not remove the Html.Raw call. *@
	@if (navItem.IsHtml)
	{
		@Html.Raw(navItem.Content)
	}
	else
	{
		@navItem.Content
	}
}
