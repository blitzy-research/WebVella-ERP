<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" forwardWindowsAuthToken="false" stdoutLogEnabled="false" startupTimeLimit="3600" requestTimeout="23:00:00" hostingModel="InProcess">
      <environmentVariables>
        <environmentVariable name="DNX_IIS_RUNTIME_FRAMEWORK" value="DNX46" />
        <!-- SECURITY - finding H-12 (High), CWE-489 active debug code / CWE-209 generation of an
           error message containing sensitive information; OWASP A05:2021 Security
           Misconfiguration. THREAT: this deployment manifest forced the Development
           environment in production, which turns on the developer exception page and its
           full stack traces, source snippets and configuration dump for anonymous callers.
           INVARIANT: the shipped value stays "Production". Override it per environment on
           the host, never here. -->
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        <environmentVariable name="COMPLUS_ForceENC" value="1" />
      </environmentVariables>
    </aspNetCore>
  </system.webServer>
</configuration>