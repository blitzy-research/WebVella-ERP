<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Security fix H-18 (CWE-1104, OWASP A06:2021 Vulnerable and Outdated Components): .NET 7 left support on 2024-05-14, so any advisory raised against the prior net7.0 target could never be patched; retargeted to the supported .NET 10 line the other 17 projects already use. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>
</Project>
