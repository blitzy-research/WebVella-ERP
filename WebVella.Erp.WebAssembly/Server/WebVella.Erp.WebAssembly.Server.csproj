<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Security H-18 (CWE-1104, OWASP A06:2021): .NET 7 left support on 2024-05-14, so an advisory
         raised against it can never be patched. Kept on the supported line the other 17 projects use. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Security H-18: hosting package kept off the end-of-life 7.0 line and aligned with the version
         the sibling Client project pins, so the WebAssembly trio stays on one supported line. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-graph integrity (H-19 class): a reference to a filename that does not exist is skipped
         silently (MSB9008), dropping that project out of the restore, audit and analyzer graph and
         making any clean scan unfounded. Keep this path exact. -->
    <ProjectReference Include="..\Client\WebVella.Erp.WebAssembly.csproj" />
    <ProjectReference Include="..\Shared\WebVella.Erp.WebAssembly.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SECURITY M-01 / H-15, QA finding P6-04: this host emitted 0 of the 7 mandated response headers
         because SecurityHeadersMiddleware was never in its compilation. The file is LINKED rather than
         reached through a ProjectReference to WebVella.Erp.Web, deliberately and as the least invasive
         option: that reference would pull Npgsql, CS-Script, AutoMapper, MailKit and the whole ERP object
         graph into an anonymous, credential-free Blazor shell that needs none of them, materially widening
         this host's dependency, audit and analyzer surface to obtain one 200-line middleware. The linked
         file's own using directives are Microsoft.AspNetCore.{Builder,Hosting,Http} and
         Microsoft.Extensions.Options plus System - every one of them already available here from the Web
         SDK - so it compiles with no dependency change at all.
         SINGLE SOURCE OF TRUTH is the point of linking rather than copying: the mandated header names and
         values, the Development HSTS suppression and the exactly-one-CSP-name invariant exist once, so this
         host cannot drift from the other seven. Keep this path exact for the same reason as the references
         above. -->
    <Compile Include="..\..\WebVella.Erp.Web\Middleware\SecurityHeadersMiddleware.cs"
             Link="Middleware\SecurityHeadersMiddleware.cs" />
  </ItemGroup>

</Project>
