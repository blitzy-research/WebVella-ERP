{
  // Security: pinned SDK - NuGetAudit defaults and the analyzer rule set are
  // SDK-version dependent; an unpinned toolchain makes the dependency and SAST
  // gates non-reproducible (finding L-07). See docs/security/secure-configuration.md
  // "latestPatch" is the deliberate roll-forward policy: it holds the pin on the
  // 10.0.3xx feature band - which is what keeps the gate reproducible, because
  // the audit mode default and the analyzer rule set are selected by the feature
  // band - while still admitting a security patch of the SDK itself. "disable"
  // was rejected because it makes the repository unbuildable the moment this
  // exact patch is superseded, breaking the "all existing functionality remains
  // operational" preservation requirement for developers and for CI.
  "sdk": {
    "version": "10.0.302",
    "rollForward": "latestPatch"
  }
}
