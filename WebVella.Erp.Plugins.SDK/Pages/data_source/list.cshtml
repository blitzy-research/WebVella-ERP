@page "/sdk/objects/data_source/l/{PageName?}"

@model WebVella.Erp.Plugins.SDK.Pages.ErpDataSource.ListModel

@{
	Layout = "~/Pages/_AppMaster.cshtml";
	ViewData["Title"] = "Datasources";
	var titleAction = "<a href=\"javascript:void(0)\" class=\"clear-filter-all\">clear all</a>";
}
<wv-page-header color="#dc3545" area-label="Data Sources" title="All data sources"
				icon-class="fa fa-cloud-download-alt" description-html="@Model.PageDescription">
	<wv-page-header-actions>
		@foreach (var action in Model.HeaderActions)
		{
			@Html.Raw(action)
		}
	</wv-page-header-actions>
</wv-page-header>

<wv-grid columns="@Model.Columns" bordered="true" hover="true" records-count="@Model.Records.Count" page="@Model.Page" page-size="@Model.PageSize" total-count="@Model.TotalCount">
	@foreach (var record in Model.Records)
	{
		<wv-grid-row>
			<wv-grid-column>
				@Html.Raw(record["action"])
			</wv-grid-column>
			<wv-grid-column>
				@* SECURITY H-06 triage (CWE-79 stored XSS, OWASP A03) - record["icon"] is deliberately NOT encoded:
				   it is server-authored markup, not text. Its only source is PageUtils.GetDataSourceIconBadge, a
				   switch over the DataSourceType enum returning one of two hardcoded literal badge strings or the
				   empty string. No return carries an interpolation hole, so no user input and no database text can
				   reach this sink on any path, and encoding it would render the badge markup as literal visible text
				   and break the grid. Accepted, documented risk; compensating controls are its server-only
				   provenance plus the Content-Security-Policy from SecurityHeadersMiddleware. *@
				@Html.Raw(record["icon"])
			</wv-grid-column>
			<wv-grid-column>
				@* SECURITY H-06 (CWE-79 stored XSS, OWASP A03) - record["name"] is operator-supplied text persisted
				   in the database, so it carries no raw-output wrapper: Razor's implicit expression HTML-encodes it
				   automatically. Rendered output is unchanged for ordinary data-source names. *@
				@record["name"]
			</wv-grid-column>
			<wv-grid-column>
				@* SECURITY H-06 (CWE-79 stored XSS, OWASP A03) - auto-encoded by Razor. record["type_description"]
				   is a compile-time DataSourceType enum label ("database" or "code"), neither of which contains an
				   HTML-special character, so output is byte-identical. *@
				@record["type_description"]
			</wv-grid-column>
			<wv-grid-column>
				@if ((int)record["type"] == 0)
				{
					<div><span class="go-gray">Entity: </span>@record["target"]</div>
				}
				else
				{
					<div><span class="go-gray">Class: </span>@record["target"]</div>
				}
			</wv-grid-column>
			<wv-grid-column>
				<code>@record["model"]</code>
			</wv-grid-column>
			<wv-grid-column>
				@* SECURITY H-06 (CWE-79 stored XSS, OWASP A03) - auto-encoded by Razor. record["param_count"] is an
				   int, so it can never contain an HTML-special character and output is byte-identical. *@
				@record["param_count"]
			</wv-grid-column>
		</wv-grid-row>
	}
</wv-grid>

<wv-drawer width="550px" title="Search Data Sources" title-action-html="@titleAction">
	<form method="get" name="SearchDataSources">
		<wv-filter-text name="name" label="Name" query-type="CONTAINS" query-options="@Model.FilterTypes"></wv-filter-text>
		<wv-filter-text name="target" label="Target" query-type="CONTAINS" query-options="@Model.FilterTypes"></wv-filter-text>
		<wv-filter-text name="model" label="Returned Model" query-type="CONTAINS" query-options="@Model.FilterTypes"></wv-filter-text>
		<wv-filter-select name="type" label="Type" query-type="CONTAINS" value-options="@Model.TypeOptions" query-options="@(new List<FilterType> { FilterType.EQ })"></wv-filter-select>
		<hr class="divider" />
		<button type="submit" class="btn btn-sm btn-white">Search Data Sources</button>
	</form>
</wv-drawer>
