@page "/sdk/objects/data_source/l/{PageName?}"

@model WebVella.Erp.Plugins.SDK.Pages.ErpDataSource.ListModel

@{
	Layout = "~/Pages/_AppMaster.cshtml";
	ViewData["Title"] = "Datasources";
	var titleAction = "<a href=\"javascript:void(0)\" class=\"clear-filter-all\">clear all</a>";
}
<wv-page-header color="#dc3545" area-label="Data Sources" title="All data sources"
				icon-class="fa fa-cloud-download-alt" description="@Model.PageDescription">
	<wv-page-header-actions>
		@foreach (var action in Model.HeaderActions)
		{
			@Html.Raw(action)
		}
	</wv-page-header-actions>
</wv-page-header>

<wv-grid columns="@Model.Columns" bordered="true" hover="true" records-count="@Model.Records.Count" page="@Model.Page" page-size="@Model.PageSize" total-count="@Model.TotalCount">
	@foreach (var record in Model.Records)
	{
		<wv-grid-row>
			<wv-grid-column>
				@Html.Raw(record["action"])
			</wv-grid-column>
			<wv-grid-column>
				@* SECURITY H-06 triage (CWE-79 stored XSS / OWASP A03:2021 Injection): record["icon"] is
				   deliberately NOT encoded, by design. It is server-authored markup, not text: its only
				   source is PageUtils.GetDataSourceIconBadge (WebVella.Erp.Web/Utils/PageUtils.cs,
				   L460-L471 at the time of this change), a switch over the DataSourceType enum that
				   returns one of two hardcoded literal badge strings or the empty string. Neither return
				   carries an interpolation hole, so no user input and no database text can reach this
				   sink on any path. Encoding it would render the badge markup as literal visible text
				   and break the grid, violating the functionality-preservation requirement. Compensating
				   controls: server-only provenance, plus the Content-Security-Policy emitted by
				   WebVella.Erp.Web/Middleware/SecurityHeadersMiddleware.cs. Accepted, documented risk. *@
				@Html.Raw(record["icon"])
			</wv-grid-column>
			<wv-grid-column>
				@* SECURITY H-06 (CWE-79 stored XSS / OWASP A03:2021 Injection): record["name"] is
				   operator-supplied text persisted in the database - list.cshtml.cs:L72 and :L86 both
				   assign record["name"] = ds.Name - and it was previously emitted through the
				   raw-output helper, so a stored script payload was rendered unencoded on every visit
				   to this list. The raw wrapper is removed so Razor's implicit expression HTML-encodes
				   automatically: no helper, no encoder and no dependency is added, which is the minimal
				   subtractive fix. Rendered output is unchanged for ordinary data-source names. *@
				@record["name"]
			</wv-grid-column>
			<wv-grid-column>
				@* SECURITY H-06 (CWE-79 stored XSS / OWASP A03:2021 Injection): the raw wrapper is
				   removed so Razor's implicit expression HTML-encodes automatically. Output is provably
				   byte-identical: record["type_description"] is a compile-time enum label, since
				   list.cshtml.cs:L74 and :L88 assign DataSourceType.DATABASE.GetLabel() and
				   DataSourceType.CODE.GetLabel(), which resolve to the literals "database" and "code"
				   declared at WebVella.Erp/Api/Models/DataSourceType.cs:L7 and :L9. Neither contains an
				   HTML-special character, so nothing is escaped in practice. *@
				@record["type_description"]
			</wv-grid-column>
			<wv-grid-column>
				@if ((int)record["type"] == 0)
				{
					<div><span class="go-gray">Entity: </span>@record["target"]</div>
				}
				else
				{
					<div><span class="go-gray">Class: </span>@record["target"]</div>
				}
			</wv-grid-column>
			<wv-grid-column>
				<code>@record["model"]</code>
			</wv-grid-column>
			<wv-grid-column>
				@* SECURITY H-06 (CWE-79 stored XSS / OWASP A03:2021 Injection): the raw wrapper is
				   removed so Razor's implicit expression HTML-encodes automatically. Output is provably
				   byte-identical: record["param_count"] is an int, assigned as ds.Parameters.Count at
				   list.cshtml.cs:L77 and as the literal 0 at :L91, so it can never contain an
				   HTML-special character. *@
				@record["param_count"]
			</wv-grid-column>
		</wv-grid-row>
	}
</wv-grid>

<wv-drawer width="550px" title="Search Data Sources" title-action-html="@titleAction">
	<form method="get" name="SearchDataSources">
		<wv-filter-text name="name" label="Name" query-type="CONTAINS" query-options="@Model.FilterTypes"></wv-filter-text>
		<wv-filter-text name="target" label="Target" query-type="CONTAINS" query-options="@Model.FilterTypes"></wv-filter-text>
		<wv-filter-text name="model" label="Returned Model" query-type="CONTAINS" query-options="@Model.FilterTypes"></wv-filter-text>
		<wv-filter-select name="type" label="Type" query-type="CONTAINS" value-options="@Model.TypeOptions" query-options="@(new List<FilterType> { FilterType.EQ })"></wv-filter-select>
		<hr class="divider" />
		<button type="submit" class="btn btn-sm btn-white">Search Data Sources</button>
	</form>
</wv-drawer>
