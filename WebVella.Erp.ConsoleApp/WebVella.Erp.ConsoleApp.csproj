<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<!-- THREAT ADDRESSED - review finding CR3-M-07 (Secret management / OWASP A05:2021 Security
		     Misconfiguration). The shipped Config.json files are blanked, so a developer needs a supply
		     channel; the configuration builders this executable uses register a Development-only user-secrets
		     provider for exactly that purpose. Without a UserSecretsId that provider resolves NO store and
		     silently loads nothing - AddUserSecrets is called with optional: true so it cannot even fail
		     loudly - which made the documented developer channel inert for this project and left editing the
		     tracked, blanked configuration file as the only way to run it. Declaring the id makes the
		     advertised channel real. It is Development-only by construction: the providers that read it are
		     registered only when the environment is Development, so this identifier has no production effect.
		     The value is a stable identifier, not a secret: the store itself lives OUTSIDE the repository, in
		     the user profile, and nothing secret is added to the tree by naming it. Do not regenerate it -
		     changing it silently orphans every developer's existing store. -->
		<UserSecretsId>9b3e4423-9b40-55c3-9abc-bcd7bcf79685</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Config.json" />
	</ItemGroup>

	<ItemGroup>
		<!-- DEFECT ADDRESSED - review finding F30 (Configuration / Availability, CWE-16, OWASP A05:2021 Security Misconfiguration): the file name here is the CONTRACT the code must honour. This item copies the tracked, capital-C Config.json to the output and publish directories, while Program.cs previously asked the configuration builder for a lower-case config.json. The two names are the same file only on a case-insensitive filesystem, so on Linux the mandatory JSON provider threw during startup before environment variables could supply any scrubbed secret. Program.cs now prefers Config.json and accepts config.json only as a fallback for deployments produced by the earlier code path. Do not re-case this item, and do not add a lower-case duplicate: either would reintroduce the divergence. -->
		<Content Include="Config.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<!-- SECURITY H-19 (OWASP A06:2021 Vulnerable and Outdated Components / A08:2021, CWE-1104-adjacent): keep this directory segment cased exactly as the folder on disk. An upper-cased "WebVella.ERP" segment broke solution-wide restore on case-sensitive filesystems, silently dropping the core project - and every package advisory it carries - out of the dependency-audit graph, so the vulnerability scan reported falsely clean. -->
		<ProjectReference Include="..\WebVella.Erp\WebVella.Erp.csproj" />
	</ItemGroup>

</Project>
