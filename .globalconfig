# =============================================================================
# REPOSITORY-WIDE SECURITY ANALYZER GATE
#
# Threat addressed: insecure coding patterns reaching production unreviewed, and
# a remediated vulnerability being silently reintroduced later - OWASP A02:2021
# (Cryptographic Failures), A03:2021 (Injection), A05:2021 (Security
# Misconfiguration) and A08:2021 (Software and Data Integrity Failures).
# Serves Validation Gate 1 - "SAST scan: 0 Critical, 0 High".
#
# Findings, evidence and disposition:
#     docs/security/security-audit-report.md
#     docs/security/remediation-log.md
#     docs/security/risk-register.md
#
# -----------------------------------------------------------------------------
# WHY THIS FILE EXISTS, AND WHY IT IS A GLOBAL ANALYZER CONFIG
# -----------------------------------------------------------------------------
# Directory.Build.props sets EnableNETAnalyzers and AnalysisLevel, but an
# analysis-level change alone does NOT switch on the security rules that ship
# disabled by default. Turning those on requires a per-rule severity entry of
# the form dotnet_diagnostic.<rule-id>.severity, and that is what this file
# supplies.
#
# It is a GLOBAL analyzer config (is_global = true) rather than an .editorconfig
# for one specific, load-bearing reason. All four .editorconfig files in this
# repository declare "root = true" - WebVella.Erp, WebVella.Erp.Web,
# WebVella.Erp.Plugins.SDK and WebVella.Erp.Plugins.Next - so a repository-root
# .editorconfig is ignored inside all four subtrees, which is precisely where the
# core and web libraries live. A global analyzer config is NOT subject to
# .editorconfig root scoping at all: the .NET SDK discovers it by walking every
# directory above each project, exactly the way Directory.Build.props is
# discovered. The authority for that is the SDK itself -
# Roslyn/Microsoft.Managed.Core.targets, which includes
# '.globalconfig' from @(_AllDirectoriesAbove) whenever
# DiscoverGlobalAnalyzerConfigFiles is not false. Directory.Build.props sets that
# property to true explicitly so the gate cannot be switched off by a toolchain
# default changing.
#
# DO NOT also add a <GlobalAnalyzerConfigFiles Include="..."/> item for this
# file. The SDK already discovers it, and adding it again makes Roslyn report
# "MultipleGlobalAnalyzerKeys: ... It has been unset" and silently DISCARD every
# severity below - a fail-open that looks exactly like success. This was
# reproduced and is the reason the wiring is left to SDK discovery.
#
# -----------------------------------------------------------------------------
# HOW THE TWO SEVERITY TIERS WERE CHOSEN - MEASURED, NOT ASSUMED
# -----------------------------------------------------------------------------
# Every rule below was first enabled at "warning" and the whole repository was
# built to count its real violations. Each rule was then placed in one of two
# tiers according to that count:
#
#   error   - measured ZERO violations across all 19 projects. Promoting these
#             costs nothing today and turns each one into a genuine regression
#             gate: the build fails the moment such a pattern is introduced.
#   warning - has pre-existing violations that cannot be removed without the
#             repository-wide refactor the remediation scope forbids. These are
#             enumerated exactly, so continuous integration can fail on any NEW
#             violation while tolerating the recorded baseline. They are
#             deliberately NOT suppressed: a blanket NoWarn would hide future
#             violations too, which is the opposite of a gate.
#
# The interprocedural taint-dataflow family (CA3001-CA3012) IS enabled - by
# AnalysisLevelSecurity in Directory.Build.props, which raises the Security
# category alone to "all" - but only because its cost is bounded here. Left at
# its default it is unaffordable: enabling it repository-wide took the solution
# build from 102 seconds to over 110 minutes without finishing, and the Roslyn
# compiler server began failing with "server rejected the request" under the
# memory load. A gate nobody can afford to run is not a gate. The per-rule
# interprocedural_analysis_kind options at the end of this file are what make it
# affordable; they restrict each rule to intraprocedural tracking without
# disabling it, changing its severity or excluding any file, and were verified
# against a probe in which CA3001, CA3003 and CA3012 fire identically with and
# without them. The residual - a taint flow crossing a method boundary is not
# followed - is recorded in docs/security/risk-register.md rather than implied to
# be covered; those findings were established by manual review and remain
# traceable in the audit report.
#
# Two kinds of entry therefore live in this file and they must not be confused.
# dotnet_diagnostic.<rule>.severity entries set SEVERITY and carry the evidence
# for each promotion. dotnet_code_quality.<rule>.<option> entries set analyzer
# OPTIONS, which have no MSBuild equivalent at all - a file is the only mechanism
# for them, which is the second reason this file exists. Neither kind suppresses
# a finding: suppressing one requires the documented risk-acceptance route in
# docs/security/risk-register.md.
#
# NEVER demote a rule below to silence a new violation. Fix the violation, or
# record a justified risk acceptance in docs/security/risk-register.md first.
# =============================================================================

is_global = true

# Positive level, stated explicitly rather than relying on the default. The .NET
# SDK ships its own global AnalyzerConfig files for the analysis levels at
# negative levels (analysislevel_10_recommended.globalconfig uses -100 and
# analysislevelsecurity_10_all.globalconfig uses -99), so a positive level makes
# the precedence of this file unambiguous instead of implied.
global_level = 100

# -----------------------------------------------------------------------------
# TAINT-ANALYSIS COST TUNING - CA3001 through CA3012.
#
# WHAT THESE RULES ARE. They are the injection dataflow family that Validation
# Gate 1 needs most: CA3001 SQL injection, CA3002 cross-site scripting, CA3003
# file-path injection, CA3004 information disclosure, CA3005 LDAP injection,
# CA3006 process-command injection, CA3007 open redirect, CA3008 XPath
# injection, CA3009 XML injection, CA3010 XAML injection, CA3011 DLL injection
# and CA3012 regular-expression injection. They map onto findings H-06 through
# H-09 and H-17 (OWASP A03:2021 - Injection) and are enabled by
# AnalysisLevelSecurity=latest-all in Directory.Build.props.
#
# WHY THE TUNING IS REQUIRED, measured rather than assumed. These rules perform
# whole-method-graph taint tracking. WebVella.Erp.Web compiles 395 Razor views
# into the same compilation as its C# sources, which makes its interprocedural
# call graph pathologically large. Measured on the pinned SDK:
#     WebVella.Erp.Web alone, no security rules ...................... 6 s
#     WebVella.Erp.Web alone, CA3002 only ........................... 9 s
#     WebVella.Erp.Web alone, CA3001 only .................. over 420 s, killed
#     WebVella.Erp.Web alone, CA3003 only .................. over 420 s, killed
#     WebVella.Erp.Web alone, CA3012 only .................. over 420 s, killed
#     WebVella.Erp.Web alone, all four with this tuning ............. 29 s
#     whole solution, Security category enabled, no tuning . over 2400 s, killed
#     whole solution, Security category enabled, this tuning ....... 530 s
# Without this file the security gate does not finish, so it cannot gate.
#
# WHY THIS IS A COST KNOB AND NOT A DETECTION LOSS. interprocedural_analysis_kind
# = None restricts each rule to intraprocedural taint tracking; it does not
# disable the rule, change its severity, or exclude any file. It was verified
# against a probe project carrying deliberate injection violations: CA3001,
# CA3003 and CA3012 fire IDENTICALLY with and without this tuning. The residual -
# that a taint flow which crosses a method boundary is not followed - is recorded
# in docs/security/risk-register.md rather than implied to be covered.
#
# WHY PER-RULE AND NOT GLOBAL. The unscoped form
# `dotnet_code_quality.interprocedural_analysis_kind` would degrade EVERY
# dataflow-based analyzer in the repository, including rules outside this family
# that cost nothing today. Scoping each entry to its own rule id keeps full
# interprocedural fidelity everywhere except the twelve rules that provably
# cannot afford it.
#
# WHY ALL TWELVE AND NOT ONLY THE FOUR MEASURED. All twelve share one taint
# engine and one call-graph walk. Tuning only the measured four would leave the
# same unbounded cost reachable through any of the other eight the moment a
# source pattern makes it fire, reintroducing a gate that does not terminate.
# -----------------------------------------------------------------------------
dotnet_code_quality.CA3001.interprocedural_analysis_kind = None
dotnet_code_quality.CA3002.interprocedural_analysis_kind = None
dotnet_code_quality.CA3003.interprocedural_analysis_kind = None
dotnet_code_quality.CA3004.interprocedural_analysis_kind = None
dotnet_code_quality.CA3005.interprocedural_analysis_kind = None
dotnet_code_quality.CA3006.interprocedural_analysis_kind = None
dotnet_code_quality.CA3007.interprocedural_analysis_kind = None
dotnet_code_quality.CA3008.interprocedural_analysis_kind = None
dotnet_code_quality.CA3009.interprocedural_analysis_kind = None
dotnet_code_quality.CA3010.interprocedural_analysis_kind = None
dotnet_code_quality.CA3011.interprocedural_analysis_kind = None
dotnet_code_quality.CA3012.interprocedural_analysis_kind = None
# -----------------------------------------------------------------------------
# TIER 1 - ERRORS. Measured zero violations; each guards a remediated finding.
# -----------------------------------------------------------------------------

# Insecure JsonSerializerSettings - TypeNameHandling other than None with NO
# SerializationBinder to constrain it. Guards findings H-10 and C-REV-10
# (CWE-502, unsafe deserialization). This rule reporting zero is the machine
# proof that ErpSerializationBinder is attached at every polymorphic
# deserialization site: CA2326 below still reports those 20 sites because it
# flags TypeNameHandling regardless of a binder, whereas CA2327 flags only the
# sites that lack one. If anyone adds a new polymorphic site without the binder,
# this is the rule that fails the build.
dotnet_diagnostic.CA2327.severity = error

# Weak hashing algorithm (SHA-1 and similar). Guards finding C-03 (CWE-916,
# use of password hash with insufficient computational effort).
dotnet_diagnostic.CA5350.severity = error

# Certificate validation disabled - a callback that unconditionally returns
# true. Guards finding H-11 (CWE-295, improper certificate validation), which
# was five such callbacks on the mail transport.
dotnet_diagnostic.CA5359.severity = error

# Deprecated transport protocol (SSL3, TLS 1.0, TLS 1.1). Enforces the
# "TLS 1.2+" clause of the mandated cryptographic standards.
dotnet_diagnostic.CA5364.severity = error

# ASP.NET Core cookies without the Secure attribute. Guards findings H-15 and
# M-REV-09 (CWE-614, sensitive cookie without Secure attribute).
dotnet_diagnostic.CA5382.severity = error
dotnet_diagnostic.CA5383.severity = error

# Hard-coded encryption key. Guards finding C-04 (CWE-321, use of hard-coded
# cryptographic key), which was a compiled-in default key with a silent
# fallback.
dotnet_diagnostic.CA5390.severity = error

# Non-random initialization vector. Guards finding M-08 (CWE-329, generation of
# predictable IV with CBC mode). That finding is latent today - it has no active
# callers - so this rule stops it becoming live.
dotnet_diagnostic.CA5401.severity = error
dotnet_diagnostic.CA5402.severity = error

# Token validation checks disabled - ValidateIssuer, ValidateAudience or
# ValidateLifetime set to false. Guards finding H-02 (CWE-613, insufficient
# session expiration), which was token lifetime validation switched off next to
# an anonymous refresh endpoint.
dotnet_diagnostic.CA5404.severity = error

# -----------------------------------------------------------------------------
# TIER 2 - WARNINGS WITH AN ENUMERATED BASELINE.
# The counts below are the measured violation totals across all 19 projects at
# the time this gate was introduced. Continuous integration compares against
# them and fails on any increase, so these families still catch regressions
# without demanding a repository-wide rewrite. If a genuine fix lowers a count,
# lower the number here too - the baseline only ever ratchets downward.
# -----------------------------------------------------------------------------

# Review SQL queries for security vulnerabilities - command text built from a
# non-constant string. BASELINE: 20 sites.
# These are the platform's metadata-driven data-access core: it composes SQL at
# runtime by design, so this rule can never reach zero here. The actual
# injection exposure was finding H-09, confined to concatenated schema
# IDENTIFIERS, and is closed by DbIdentifier validate-and-quote; values
# throughout the data layer were already parameterized. The rule is kept on
# because it is the correct place to notice a NEW dynamic query.
dotnet_diagnostic.CA2100.severity = warning

# Do not use TypeNameHandling values other than None. BASELINE: 20 sites.
# Do not use insecure deserializer with unvalidated data. BASELINE: 9 sites.
# Every one of these sites has ErpSerializationBinder attached - proven by
# CA2327 above reporting zero - so the weakness is closed by a compensating
# control the analyzer cannot see. Type handling itself cannot be removed:
# already-persisted entity, relation and job payloads carry type discriminators
# and would fail to deserialize, breaking existing installations.
dotnet_diagnostic.CA2326.severity = warning
dotnet_diagnostic.CA2328.severity = warning

# Broken cryptographic algorithm (MD5). BASELINE: 5 sites.
# Four are the general-purpose digest helpers in CryptoUtility, outside the
# remediated key handling. The fifth is the legacy password-verification path,
# which exists precisely so credentials stored before the C-03 remediation keep
# working and are transparently upgraded on next sign-in. Removing it would lock
# every existing user out, so it is a deliberate, documented residual - not an
# oversight, and not to be "fixed" by deleting the legacy path.
dotnet_diagnostic.CA5351.severity = warning

# Potential reference cycle in a deserialized object graph. BASELINE: 1 site.
# WebVella.Erp/Api/Models/QueryObject.cs, where SubQueries is a collection of the
# same type. Self-nesting query objects are how the entity query language
# expresses sub-queries, so the shape cannot be removed without removing the
# feature. The denial-of-service concern the rule describes - unbounded expansion
# while materialising a hostile graph - is bounded elsewhere: ErpSerializationBinder
# admits only the platform's own inert persisted types, and query depth is bounded
# by the query compiler. Enumerated here because the security category enables this
# rule at warning severity, so leaving it out of this baseline would let its count
# grow without the gate noticing.
dotnet_diagnostic.CA5362.severity = warning
