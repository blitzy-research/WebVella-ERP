@addTagHelper *, WebVella.Erp.Plugins.Core
@addTagHelper *, WebVella.Erp.Web
@addTagHelper *, WebVella.TagHelpers
@using WebVella.Erp.Web.Utils;
@using WebVella.Erp.Api.Models;
@using WebVella.Erp.Web.Models;
@using WebVella.Erp.Plugins.Project.Components;
@using WebVella.TagHelpers.Models;
@{
	var options = (PcProjectWidgetTasksChart.PcProjectWidgetTasksChartOptions)ViewBag.Options;
	var datasets = (List<WvChartDataset>)ViewBag.Datasets;
	var chartLabels = (List<string>)ViewBag.ChartLabels;
	var overdueTasks = (int)ViewBag.OverdueTasks;
	var dueToday = (int)ViewBag.DueTodayTasks;
	var notDueTasks = (int)ViewBag.NotDueTasks;
}
<wv-row flex-vertical-alignment="Center" class="w-100 h-100" no-gutters="true">
	<wv-column class="flex-grow-0">
		<wv-chart type="Doughnut" datasets="@datasets" labels="@chartLabels" width="100px" height="100px"></wv-chart>
		@*P6-03: the wv-chart tag helper writes tooltips:{enabled:false} into its Chart.js
		  configuration and exposes no attribute to change it, so this file re-enables them from a
		  beforeInit plugin. It must load AFTER wv-chart, which emits Chart.bundle.min.js and then
		  registers the constructor in a jQuery ready handler - by this point Chart exists and no
		  chart has been built yet. An external file, never inline, so script-src 'self' still holds.*@
		<script src="/_content/WebVella.Erp.Plugins.Project/js/wv-chart-tooltips/wv-chart-tooltips.js"></script>
	</wv-column>
	<wv-column class="flex-grow-1 pl-4">
		<wv-row class="mb-2">
			<wv-column>
				<div>Overdue</div>
				<div class="@(overdueTasks > 0 ? "go-red" : "go-gray")">@overdueTasks</div>		
			</wv-column>
			<wv-column>
				<div>Due today</div>
				<div class="@(dueToday > 0 ? "go-orange" : "go-gray")">@dueToday</div>		
			</wv-column>
		</wv-row>
		<wv-row class="mb-2">
			<wv-column>
				<div>Upcoming due</div>
				<div class="@(notDueTasks > 0 ? "go-green" : "go-gray")">@notDueTasks</div>	
			</wv-column>

		</wv-row>		
	</wv-column>
</wv-row>