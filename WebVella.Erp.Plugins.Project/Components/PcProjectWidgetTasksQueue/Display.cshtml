@addTagHelper *, WebVella.Erp.Plugins.Core
@addTagHelper *, WebVella.Erp.Web
@addTagHelper *, WebVella.TagHelpers
@using WebVella.Erp.Web.Utils;
@using WebVella.Erp.Api.Models;
@using WebVella.Erp.Web.Models;
@using WebVella.Erp.Plugins.Project.Components;
@using WebVella.Erp.Plugins.Project.Model;
@using WebVella.TagHelpers.Models;
@{
	var options = (PcProjectWidgetTasksQueue.PcProjectWidgetTasksQueueOptions)ViewBag.Options;
	var records = (List<EntityRecord>)ViewBag.Records;
	var gridColumn = new List<WvGridColumnMeta>() {
		new WvGridColumnMeta(){
			Name = "name",
			Width = "",
			Label = "name"
		},
		new WvGridColumnMeta(){
			Name = "user",
			Width = "200px",
			Label = "user"
		},
		new WvGridColumnMeta(){
			Name = "date",
			Width = "120px",
			Label = "date"
		}
	};
}
@if(records.Count > 0){
<wv-grid small="true" columns="@gridColumn"  has-tfoot="false" has-thead="false">
	@foreach (var record in records)
	{
		var dateString = "no target date";
		var dateClass = "go-gray";
		if (record["date"] != null) {
			dateClass = "";
			dateString = ((DateTime)record["date"]).ToString("dd MMM yyyy");
		}

		@switch (options.Type)
		{
			case TasksDueType.EndTimeDueToday:
				dateClass = "go-orange";
				break;
			case TasksDueType.EndTimeOverdue:
				dateClass = "go-red";
				break;
			default:
				break;
		}
		@* SECURITY - finding H-06 (CWE-79, OWASP A03: stored cross-site scripting). REMEDIATED.
		   THREAT: these two cells used to render pre-built markup strings through Html.Raw, so the task
		   key, the task subject, the owner name, the avatar path and the priority icon class and colour
		   - all of them database text - executed in the browser of every user who opened a dashboard
		   carrying this widget. A task subject is editable by any user who can edit a task, which made
		   this the widest-reach sink of the group.
		   HOW IT IS FIXED: PcProjectWidgetTasksQueue.cs no longer builds markup. It publishes each value
		   as its own data field, additionally allow-listing the icon class and the colour, and the
		   elements are authored here as literal Razor markup so Razor encodes every value in its own
		   context - attribute values as attributes, link text as text.
		   The priority icon carries no text of its own and the subject beside it conveys the same row,
		   so it is marked aria-hidden rather than being given an invented label.
		   Do not reintroduce Html.Raw here, and do not move the markup back into the component. *@
		var taskUrl = $"/projects/tasks/tasks/r/{record["task_id"]}/details";
		var taskIconClass = (string)record["task_icon_class"];
		var taskColorStyle = "color:" + (string)record["task_color"];
		var userImagePath = (string)record["user_image"];
		<wv-grid-row>
			<wv-grid-column><i class="@taskIconClass" style="@taskColorStyle" aria-hidden="true"></i> <a href="@taskUrl">[@record["task_key"]] @record["task_subject"]</a></wv-grid-column>
			<wv-grid-column width="200px"><img src="@userImagePath" class="rounded-circle" width="24" alt="" /> @record["user_name"]</wv-grid-column>
			<wv-grid-column width="120px" class="@dateClass">@dateString</wv-grid-column>
		</wv-grid-row>
	}
</wv-grid>
}
else { 
	@switch (options.Type)
	{
		case TasksDueType.EndTimeDueToday:
			<div class="alert alert-info p-2 m-0">No tasks due today</div>
			break;
		case TasksDueType.EndTimeOverdue:
			<div class="alert alert-info p-2 m-0">No overdue tasks</div>
			break;
		case TasksDueType.EndTimeNotDue:
			<div class="alert alert-info p-2 m-0">No upcoming tasks</div>
			break;
		default:
			<div class="alert alert-info p-2 m-0">No overdue tasks</div>
			break;
	}
}