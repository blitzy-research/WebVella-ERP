@addTagHelper *, WebVella.Erp.Plugins.Core
@addTagHelper *, WebVella.Erp.Web
@addTagHelper *, WebVella.TagHelpers
@using WebVella.Erp.Web.Utils;
@using WebVella.Erp.Api.Models;
@using WebVella.Erp.Web.Models;
@using WebVella.Erp.Plugins.Project.Components;
@using WebVella.TagHelpers.Models;
@{
	var options = (PcProjectWidgetTaskDistribution.PcProjectWidgetTaskDistributionOptions)ViewBag.Options;
	var records = (List<EntityRecord>)ViewBag.Records;
	var gridColumn = new List<WvGridColumnMeta>() {
		new WvGridColumnMeta(){
			Name = "",
			Width = "",
			Label = ""
		},
		new WvGridColumnMeta(){
			Name = "overdue",
			Width = "80px",
			Label = "overdue"
		},
		new WvGridColumnMeta(){
			Name = "today",
			Width = "80px",
			Label = "today"
		},
		new WvGridColumnMeta(){
			Name = "other",
			Width = "80px",
			Label = "other"
		},
	};
}
@if (records.Count > 0)
{
<wv-grid bordered="true" small="true" columns="@gridColumn" has-tfoot="false">
	@foreach (var record in records)
	{
		@* SECURITY - finding H-06 (CWE-79, OWASP A03: stored cross-site scripting). REMEDIATED.
		   THREAT: this cell used to render a pre-built markup string through Html.Raw, so the avatar
		   path and the owner name - both database text that anyone able to edit a user record
		   controls - executed in the browser of every user who opened a dashboard carrying this widget.
		   HOW IT IS FIXED: PcProjectWidgetTaskDistribution.cs no longer builds markup. It publishes the
		   two values as the data fields user_image and user_name, and the avatar element is authored
		   here as literal Razor markup. Razor auto-encodes the src attribute value and the name text,
		   each in its own context, so the raw sink is gone rather than merely documented.
		   The avatar is decorative and the owner name is adjacent to it, so alt is intentionally empty.
		   Do not reintroduce Html.Raw here, and do not move the markup back into the component. *@
		<wv-grid-row>
			<wv-grid-column><img src="@((string)record["user_image"])" class="rounded-circle" width="24" alt="" /> @record["user_name"]</wv-grid-column>
			<wv-grid-column class="@((int)record["overdue"] > 0 ? "go-bkg-red-light" : "")">@record["overdue"]</wv-grid-column>
			<wv-grid-column class="@((int)record["today"] > 0 ? "go-bkg-orange-light" : "")">@record["today"]</wv-grid-column>
			<wv-grid-column>@record["other"]</wv-grid-column>
		</wv-grid-row>
	}
</wv-grid>
}
else { 
	<div class="alert alert-info">No tasks found in queue</div>
}